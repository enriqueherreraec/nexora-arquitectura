# ==============================================================================
# NEXORA - Plantilla de Variables de Entorno del Backend
# Copie este archivo como backend/.env y configure sus valores locales
# Las credenciales y contraseñas permanecen exclusivamente en el backend
# ==============================================================================

PROJECT_NAME=Nexora - Sistema de Orientación Vocacional Universitaria
PROJECT_VERSION=0.3.0
ENVIRONMENT=development
PORT=8002
API_V1_PREFIX=/api/v1

# Seguridad y Criptografía (Argon2 + JWT)
SECRET_KEY=nexora_jwt_secret_key_ec_academico_2026_segura_32caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Base de Datos PostgreSQL Local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=escriba_aqui_su_contraseña_local
DB_NAME=orientacion_vocacional_db

# CORS para comunicación con el Frontend
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# SERVICIO SMTP PARA ENVÍO REAL DEL INFORME PDF (Informe_vocacional_Nexora.pdf)
# Configure las credenciales de su proveedor de correo saliente.
# Ejemplo para Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=su_correo@gmail.com
#   SMTP_PASSWORD=contraseña_de_aplicacion_de_16_caracteres
#   SMTP_FROM_EMAIL=su_correo@gmail.com
#   SMTP_FROM_NAME=Nexora - Orientación Vocacional Ecuador
#   SMTP_USE_TLS=True
#   SMTP_USE_SSL=False
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nexora - Orientación Vocacional Ecuador
SMTP_USE_TLS=True
SMTP_USE_SSL=False
