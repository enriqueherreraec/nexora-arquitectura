# ==============================================================================
# NEXORA - Plantilla de Variables de Entorno (.env.example)
# Copie este archivo como .env y complete sus valores locales.
# NO suba archivos .env con credenciales reales al repositorio.
# ==============================================================================

# Entorno de ejecución: development | production | testing
ENVIRONMENT=development
PORT=8002

# Clave secreta obligatoria para firma de tokens JWT (HS256)
# En producción/desarrollo debe ser una cadena aleatoria de al menos 32 caracteres
SECRET_KEY=colocar_aqui_clave_secreta_jwt_de_al_menos_32_caracteres_aleatorios

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_de_postgresql_aqui
DB_NAME=nexora_semana2

# Servicio de Correo SMTP (Gmail u otro proveedor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
SMTP_FROM_EMAIL=nexora.orientacion@gmail.com
SMTP_TIMEOUT_SECONDS=3

# Control de simulación de correo
# En producción y desarrollo debe permanecer en false para evitar confirmaciones falsas.
# Solo en testing y activado explícitamente se permite simular el despacho sin enviar correos reales.
MODO_PRUEBAS_SIMULACION_CORREO=false
